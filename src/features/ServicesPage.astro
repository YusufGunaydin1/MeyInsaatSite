---
import Base from '../layouts/Base.astro';
import PlaceholderChip from '../components/PlaceholderChip.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { type Locale } from '../lib/i18n';
import { ui, pageContent } from '../lib/content';
import { breadcrumbLd, serviceCatalogLd } from '../lib/schema';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);
const fm = pageContent('hizmetler', locale)?.frontmatter ?? {};
const jsonLd = [
  breadcrumbLd(Astro.site, locale, [
    { name: t.nav.home, path: '/' },
    { name: t.nav.services },
  ]),
  serviceCatalogLd(
    Astro.site,
    locale,
    (fm.services ?? []).map((s: any) => ({ name: s.name, desc: s.desc }))
  ),
];

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.webp',
  { eager: true }
);
const photo = (name: string) =>
  photos[`../assets/photos/${name}.webp`]!.default;
---

<Base locale={locale} page="services" path="/hizmetler" jsonLd={jsonLd}>
  <section class="container-site section-pad">
    <div class="guide-line-v ps-6 sm:ps-10">
      <p class="t-tech text-mey-red mb-4">{t.nav.services.toUpperCase()}</p>
      <h1 class="t-display-xl">{fm.title}</h1>
      <p class="t-body-l mt-6 max-w-2xl">{fm.intro}</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 mt-14">
      {(fm.services ?? []).map((svc: any) => (
        <div class:list={['card p-6', !svc.confirmed && 'border-dashed']}>
          {!svc.confirmed && (
            <p class="mb-3"><PlaceholderChip locale={locale} /></p>
          )}
          <h2 class="t-heading-m">{svc.name}</h2>
          <p class="t-body mt-3">{svc.desc}</p>
        </div>
      ))}
    </div>
  </section>

  {/* Hizmet detay sayfaları yalnız TR yayında (mevzuat metni makine çevirisiyle
      yayınlanmaz) — diğer dillerde bu blok hiç basılmaz, yoksa 404'e link verir. */}
  {locale === 'tr' && fm.detailPages && (
    <section class="bg-night-950 text-concrete-050 border-y border-line">
      <div class="container-site section-pad">
        <h2 class="t-display-l reveal">{fm.detailPages.title}</h2>
        <p class="t-body-l mt-4 max-w-2xl text-concrete-100/80">{fm.detailPages.intro}</p>
        <ul class="grid gap-4 md:grid-cols-3 mt-12">
          {(fm.detailPages.items ?? []).map((it: any) => (
            <li class="reveal">
              <a href={`/hizmetler/${it.slug}/`} class="sd-link">
                <h3 class="t-heading-m">{it.name}</h3>
                <p class="t-caption mt-3 text-concrete-100/75">{it.desc}</p>
                <span class="t-tech sd-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bg-concrete-100 border-y border-line">
    <div class="container-site section-pad">
      <h2 class="t-display-l reveal">{fm.process?.title}</h2>
      <div class="mt-12">
        <ProcessSteps steps={fm.process?.steps ?? []} />
      </div>

      <div class="grid gap-4 sm:grid-cols-2 mt-10">
        {['planning-design-desk', 'materials-finish-palette'].map((name) => (
          <figure class="card overflow-hidden reveal">
            <Image
              src={photo(name)}
              alt={t.photoAlt[name]}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 1024px) 640px, 100vw"
              class="w-full aspect-[4/3] object-cover"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Koyu banttaki hizmet kartları: çerçeve kırmızıya döner, ok sağa kayar.
     Gölge yok — tasarım brifi düz yüzey ister. */
  .sd-link {
    display: block;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid rgb(244 244 242 / 0.18);
    border-radius: var(--radius-brand);
    transition: border-color 160ms ease;
  }
  .sd-link:hover,
  .sd-link:focus-visible { border-color: var(--color-red-on-dark); }
  .sd-go {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-red-on-dark);
    transition: transform 160ms ease;
  }
  .sd-link:hover .sd-go { transform: translateX(0.25rem); }
  :global([dir='rtl']) .sd-go { transform: scaleX(-1); }
  :global([dir='rtl']) .sd-link:hover .sd-go { transform: scaleX(-1) translateX(0.25rem); }
  @media (prefers-reduced-motion: reduce) {
    .sd-go, .sd-link { transition: none; }
    .sd-link:hover .sd-go { transform: none; }
  }
</style>
