---
/*
  Gerçek harita bağlantıları. Doğrulanmış koordinat varsa üç sağlayıcı da aynı
  kesin pine açılır; yalnız koordinatı olmayan adreslerde metin araması yedektir.
  UA koklama yok — RU yereli Yandex'i öne alır, kalan yereller Google önde.
*/
import type { Locale } from '../lib/i18n';
import { mapProviderLinks, type MapCoordinates } from '../lib/maps';

interface Props {
  /** düz metin adres, ör. "Batı Mah. Maşuk Sok. No:10, Pendik/İstanbul" */
  address: string;
  locale: Locale;
  /** yerelleştirilmiş "Haritada aç" etiketi */
  label: string;
  /** harita sağlayıcılarını aynı kesin pine bağlayan doğrulanmış koordinat */
  coordinates?: MapCoordinates | null;
  /** Apple Maps pin etiketi; verilmezse adres kullanılır */
  name?: string;
}
const { address, locale, label, coordinates, name } = Astro.props;
const providers = mapProviderLinks({ address, coordinates, locale, name });
---

<p class="t-tech maplinks" data-testid="map-links">
  <span class="maplinks-label">{label}:</span>
  {providers.map((p) => (
    <a href={p.href} target="_blank" rel="noopener" data-testid={`map-${p.name.toLowerCase()}`}>{p.name}</a>
  ))}
</p>

<style>
  .maplinks {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
  }
  .maplinks-label { color: var(--color-graphite-400); }
  .maplinks a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--color-graphite-900);
  }
  .maplinks a:hover { color: var(--color-mey-red); }
  .maplinks a + a { position: relative; }
  .maplinks a + a::before {
    content: "·";
    position: absolute;
    inset-inline-start: -0.55rem;
    color: var(--color-graphite-400);
    pointer-events: none;
  }
</style>
