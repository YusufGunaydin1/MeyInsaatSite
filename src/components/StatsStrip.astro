---
/*
  Publish verified numbers only; missing company totals are not visitor content.
*/
import type { Locale } from '../lib/i18n';
import { ui, company } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);

const stats = [
  { key: 'groupYears', value: company.groupYears, hero: true },
  { key: 'constructionFoundedYear', value: company.constructionFoundedYear },
  { key: 'projectsCompleted', value: company.stats.projectsCompleted },
  { key: 'unitsDelivered', value: company.stats.unitsDelivered },
].filter((stat) => stat.value !== null && stat.value !== undefined);
---

<dl class="grid grid-cols-2 gap-px bg-line border border-line rounded-brand overflow-hidden reveal" class:list={{ 'lg:grid-cols-4': stats.length === 4 }}>
  {stats.map((s) => (
    <div class="bg-white p-5 sm:p-6">
      <dd
        class:list={[
          't-display-l tabular-nums',
          s.hero ? 'text-mey-red' : 'text-graphite-900',
        ]}
      >
        {s.value}
      </dd>
      <dt class="t-tech text-graphite-400 mt-2">{t.stats[s.key]}</dt>
    </div>
  ))}
</dl>
