---
/*
  /iletisim talep formu — satılık raylarındaki ADA'nın aynısı, geniş yerleşimde.
  Kanallar burada OFİS hattıdır: satış numarası ve WhatsApp yalnız
  /satilik-daireler/** yüzeyinde yayımlanır, genel talepler santrale gider.
*/
import RailForm from '../showcase/satilik/kompakt/RailForm';
import { company } from '../../lib/content';
import { contactNumber, telHref } from '../../lib/contact';
import { salesMessages, islandMessages } from '../../lib/salesContent';
import { translator } from '../../lib/translate';
import type { Locale } from '../../lib/i18n';
import '../showcase/satilik/kompakt/kompakt.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const messages = salesMessages(locale);
const tx = translator(messages);
const enabled = Boolean(company.contact.formAccessKey?.trim());

const phone = contactNumber(company.contact.phone);
const phoneHref = telHref(company.contact.phone);
const email = company.contact.email;

const fallback = [
  ...(phone && phoneHref ? [{ kind: 'call' as const, label: tx('Ara'), detail: phone.display, href: phoneHref }] : []),
  ...(email ? [{ kind: 'email' as const, label: tx('E-posta'), detail: email, href: `mailto:${email}` }] : []),
];
---

<section
  class="cf"
  aria-labelledby="contact-form-title"
  data-testid="contact-form"
>
  <div class="container-site cf-wrap">
    <p class="t-tech cf-kicker">{tx(enabled ? 'TALEP FORMU' : 'HIZLI İLETİŞİM')}</p>
    <h2 id="contact-form-title" class="t-heading-m cf-title">{tx(enabled ? 'Bize Yazın' : 'Doğrudan ulaşın')}</h2>
    <p class="cf-sub">
      {tx(enabled ? 'Formu doldurun; size dönüş yapalım. Dilerseniz doğrudan arayın.' : 'Aşağıdaki kanallardan bize ulaşabilirsiniz.')}
    </p>

    <RailForm
      client:load
      messages={islandMessages(messages, 'form')}
      wide
      konu={tx("İletişim")}
      daire={tx("Genel iletişim")}
      subject="Web Formu · İletişim"
      formLocation="iletisim"
      fallback={fallback}
      privacyHref="/gizlilik-ve-cerez-politikasi/"
      accessKey={company.contact.formAccessKey ?? ''}
    />
  </div>
</section>

<style>
  .cf {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-block-start: 1px solid var(--color-line);
    background-color: var(--color-concrete-050);
  }
  .cf-wrap { max-width: 46rem; }
  .cf-kicker { color: var(--color-mey-teal-700); }
  .cf-title { margin-top: 0.35rem; }
  .cf-sub { margin-block: 0.5rem 1.1rem; color: var(--color-graphite-600); }
</style>
