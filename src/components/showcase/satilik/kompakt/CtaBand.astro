---
import type { Locale } from "../../../../lib/i18n";
import { salesMessages } from "../../../../lib/salesContent";
import { translator } from "../../../../lib/translate";
/*
  Koyu CTA bandı — satış telefonu yalnız for-sale yüzeylerinde yayınlanır;
  genel şirket hattından ayrı tutulur.
*/
import Icon from './Icon.astro';
import { company } from '../../../../lib/content';
import { contactNumber, telHref, whatsappHref } from '../../../../lib/contact';

interface Props {
  locale?: Locale;
  base: string;
}
const messages = salesMessages(Astro.props.locale ?? 'tr');
const tx = translator(messages);
const { locale = 'tr', base } = Astro.props;
const salesPhone = contactNumber(company.salesContact.phone);
const salesPhoneHref = telHref(company.salesContact.phone);
---

<section class="kc-ctaband theatre" data-testid="kc-ctaband">
  <div class="container-site kc-ctaband-in">
    <div>
      <h2 class="t-heading-m kc-ctaband-title">{tx("Hayalinizdeki daireyi birlikte bulalım.")}</h2>
      <p class="t-caption kc-ctaband-sub">
        {tx("Detaylı bilgi almak veya daireleri yerinde görmek için bizimle iletişime geçin.")}
      </p>
    </div>
    <div class="kc-ctaband-actions">
      {salesPhone && salesPhoneHref && (
        <a class="btn-ghost" href={salesPhoneHref} data-testid="kc-sales-phone">
          <Icon name="phone" size={17} /> <bdi dir="ltr">{salesPhone.display}</bdi>
        </a>
      )}
      <a
        class="btn-primary"
        href={whatsappHref(company.salesContact.whatsapp, tx("Merhaba, satılık daireyi yerinde görmek için randevu almak istiyorum.")) ?? '#'}
        data-testid="kc-ctaband-randevu"
      >
        <Icon name="calendar" size={17} /> {tx("Randevu Al")}
      </a>
    </div>
  </div>
</section>

<style>
  .kc-ctaband { border-radius: var(--radius-brand); }
  .kc-ctaband-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-block: 1.6rem;
  }
  .kc-ctaband-title { color: #fff; }
  .kc-ctaband-sub { color: rgb(244 244 242 / 0.65); margin-top: 0.25rem; max-width: 46ch; }
  .kc-ctaband-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
</style>
