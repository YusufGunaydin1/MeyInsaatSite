---
import type { Locale } from "../../../../lib/i18n";
import { salesMessages, islandMessages } from "../../../../lib/salesContent";
import { translator } from "../../../../lib/translate";
/*
  Yapışkan sağ ray — for-sale alanına özel telefon/WhatsApp, Hızlı Bilgi Alın
  mini formu ve güven kalemleri. İki detay dizilimi aynı bileşeni kullanır.
*/
import Icon from './Icon.astro';
import RailForm from './RailForm.tsx';
import { company } from '../../../../lib/content';
import { contactNumber, telHref, whatsappHref } from '../../../../lib/contact';

interface Props {
  locale?: Locale;
  konu: string;
  /** talep e-postasının konu satırı; verilmezse konudan türetilir */
  subject?: string;
  /** ölçümde sayfa kırılımı */
  formLocation: string;
}
const messages = salesMessages(Astro.props.locale ?? 'tr');
const tx = translator(messages);
const { konu, subject, formLocation } = Astro.props;
const salesPhone = contactNumber(company.salesContact.phone);
const salesWhatsapp = contactNumber(company.salesContact.whatsapp);
const salesPhoneHref = telHref(company.salesContact.phone);
const salesWhatsappHref = whatsappHref(company.salesContact.whatsapp);

// Form başarısız olursa ya da gönderim sonrası hemen konuşmak isterlerse:
// bu yüzey satış hattına aittir, ofis santraline değil.
const formFallback = [
  ...(salesPhone && salesPhoneHref
    ? [{ kind: 'call' as const, label: tx('Ara'), detail: salesPhone.display, href: salesPhoneHref }]
    : []),
  ...(salesWhatsapp
    ? [{
        kind: 'whatsapp' as const,
        label: tx("WhatsApp'tan Sor"),
        href: whatsappHref(company.salesContact.whatsapp, tx('Merhaba, {konu} hakkında bilgi almak istiyorum.', { konu })) ?? salesWhatsappHref!,
      }]
    : []),
];

const trust = [
  { icon: 'shield', title: tx("Tapu güvencesi"), sub: tx("Kat mülkiyeti ile alım") },
  { icon: 'key', title: tx("Aracısız satış"), sub: tx("Doğrudan müteahhitten") },
  { icon: 'chat', title: tx("Satış sonrası destek"), sub: tx("Tek muhatap: Mey İnşaat") },
];
---

<aside class="kc-rail" data-testid="kc-rail">
  <div class="kc-rail-office theatre">
    <p class="t-tech kc-rail-kicker">{tx("MEY İNŞAAT · SATIŞ OFİSİ")}</p>
    {salesPhone && salesPhoneHref && (
      <a class="kc-rail-btn" href={salesPhoneHref} data-testid="kc-rail-phone">
        <Icon name="phone" size={17} /> <bdi dir="ltr">{salesPhone.display}</bdi>
      </a>
    )}
    {salesWhatsapp && salesWhatsappHref && (
      <a class="kc-rail-btn" href={whatsappHref(company.salesContact.whatsapp, tx('Merhaba, {konu} hakkında bilgi almak istiyorum.', { konu })) ?? salesWhatsappHref} data-testid="kc-rail-whatsapp">
        <Icon name="chat" size={17} /> WhatsApp · <bdi dir="ltr">{salesWhatsapp.display}</bdi>
      </a>
    )}
    {salesWhatsapp && (
      <a
        class="kc-rail-btn is-solid"
        href={whatsappHref(company.salesContact.whatsapp, tx('Merhaba, {konu} için yerinde randevu almak istiyorum.', { konu })) ?? '#'}
        data-testid="kc-rail-randevu"
      >
        <Icon name="calendar" size={17} /> {tx("Randevu Al")}
      </a>
    )}
  </div>

  <div class="kc-rail-form">
    <h3 class="t-heading-s">{tx("Hızlı Bilgi Alın")}</h3>
    <p class="t-caption kc-rail-formsub">{tx('{konu} hakkında bilgi isteyin; size dönelim.', { konu })}</p>
    <RailForm messages={islandMessages(messages, 'form')}
      client:load
      konu={konu}
      daire={konu}
      subject={subject ?? `Web Formu · ${konu}`}
      formLocation={formLocation}
      fallback={formFallback}
      privacyHref="/gizlilik-ve-cerez-politikasi/"
      accessKey={company.contact.formAccessKey ?? ''}
    />
  </div>

  <ul class="kc-rail-trust card">
    {trust.map((t) => (
      <li>
        <span class="kc-rail-trust-ic"><Icon name={t.icon} size={19} /></span>
        <div>
          <p class="kc-rail-trust-title">{t.title}</p>
          <p class="kc-rail-trust-sub">{t.sub}</p>
        </div>
      </li>
    ))}
  </ul>
</aside>

<style>
  .kc-rail {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    position: sticky;
    top: 1rem;
  }
  .kc-rail-office {
    border-radius: var(--radius-brand);
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .kc-rail-kicker { color: var(--color-mey-teal); margin-bottom: 0.2rem; }
  .kc-rail-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius-brand);
    background: none;
    color: #fff;
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .kc-rail-btn:hover { background: rgb(255 255 255 / 0.08); }
  .kc-rail-btn.is-solid { background: var(--color-mey-red); border-color: var(--color-mey-red); }
  .kc-rail-btn.is-solid:hover { background: var(--color-mey-red-700); }
  .kc-rail-form {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-brand);
    padding: 1rem 1.1rem 1.1rem;
  }
  .kc-rail-form :global(.kcf) { border: none; padding: 0; margin-top: 0.6rem; }
  .kc-rail-formsub { color: var(--color-graphite-400); margin-top: 0.2rem; }
  .kc-rail-trust { padding: 0.9rem 1.1rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .kc-rail-trust li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .kc-rail-trust-ic { color: var(--color-mey-teal-700); display: inline-flex; margin-top: 0.1rem; }
  .kc-rail-trust-title { font-weight: 600; font-size: 0.875rem; color: var(--color-graphite-900); line-height: 1.25; }
  .kc-rail-trust-sub { font-size: 0.8125rem; color: var(--color-graphite-400); }
  @media (max-width: 1023px) {
    .kc-rail { position: static; }
  }
</style>
