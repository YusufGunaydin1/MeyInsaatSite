---
import { buildStages as stages } from './constructionData';
const frameModules = import.meta.glob<string>('../../../assets/frames/frame-*.webp', {
  eager: true, query: '?url', import: 'default',
});
const frames = Object.keys(frameModules).sort().map((key) => frameModules[key]);
---

<section id="sinema" class="motion-lab ml-build blueprint-grid" data-motion-build data-testid="motion-build"
  data-frames={JSON.stringify(frames)} data-mode="manual" data-frame="17" aria-labelledby="ml-build-title">
  <div class="ml-build-runway" data-build-runway>
    <div class="ml-build-stage" data-build-sticky>
      <div class="container-site ml-build-grid">
        <div class="ml-build-story">
          <p class="t-tech ml-label">A / Zamanın mimarisi</p>
          <h2 id="ml-build-title" class="t-display-l">Bir çizgiden,{' '}<br />bir yapıya.</h2>
          <p class="ml-description ml-build-intro">Sayfayı kaydırın. Yapının yükselişini adım adım izleyin; istediğiniz karede durup inceleyin.</p>
          <ol class="ml-build-stages" aria-label="Yapım aşamaları">
            {stages.map((stage, index) => (
              <li>
                <button type="button" class="ml-build-stage-button" data-build-stage={index}
                  data-frame-target={stage.frame} data-testid={`build-stage-${index}`} aria-pressed={index === 3} disabled>
                  <span class="t-tech">0{index + 1}</span><span>{stage.short}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
        <div class="ml-build-image">
          <img src={frames.at(-1)} alt="Mevcut yapım sekansının son karesi: betonarme ve tuğla dolgulu kaba yapı"
            width="900" height="1600" loading="eager" decoding="async" data-build-poster />
          <canvas width="900" height="1600" aria-hidden="true" data-build-canvas></canvas>
          <div class="ml-build-datum" data-build-datum aria-hidden="true"><span>YAPIM SEVİYESİ</span></div>
          <span class="ml-build-image-label t-tech">Mevcut ana sayfa sekansı</span>
        </div>
        <div class="ml-build-meter">
          <p class="t-tech ml-label">Kare / <span>{frames.length}</span></p>
          <p class="ml-build-number" data-build-number>17</p>
          <h3 data-build-heading>{stages[3].name}</h3>
          <p class="ml-description" data-build-description>{stages[3].description}</p>
          <div class="ml-build-track" aria-hidden="true"><i data-build-progress></i></div>
          <p class="ml-source">Kaydırma, görüntü dizisinin zamanını kontrol eder. Bu gösterim, tarihli bir şantiye ilerleme raporu değildir.</p>
        </div>
      </div>
      <div class="container-site ml-build-toolbar ml-controls">
        <div class="ml-buttons" role="group" aria-label="Sekans kontrolü">
          <button type="button" class="ml-button" data-build-mode="scroll" data-testid="build-mode-scroll" aria-pressed="false">Kaydırarak oynat</button>
          <button type="button" class="ml-button" data-build-mode="manual" data-testid="build-mode-manual" aria-pressed="true">Kare seç</button>
        </div>
        <label class="ml-range-group ml-build-range">
          <span class="ml-range-label"><span>Yapım ilerlemesi</span><output data-build-percent>100%</output></span>
          <input class="ml-range" type="range" min="0" max={frames.length - 1} step="1" value={frames.length - 1}
            aria-label="Yapım karesi" data-testid="build-frame-range" data-build-range />
        </label>
        <button type="button" class="ml-button" data-build-reset data-testid="build-reset">Başa dön</button>
        <a href="#katmanlar" class="ml-button">Sonraki tasarım ↓</a>
        <p class="ml-source ml-build-status" role="status" data-build-status>Görüntü dizisi hazırlanıyor.</p>
      </div>
      <noscript><div class="container-site"><p class="ml-noscript">Yapım sekansının son karesi ve dört aşaması gösteriliyor. Kare seçimi ve kaydırma deneyimi için JavaScript gereklidir.</p></div></noscript>
    </div>
  </div>
</section>

<script>
  import { initConstructionCinema } from './construction';
  document.querySelectorAll<HTMLElement>('[data-motion-build]').forEach(initConstructionCinema);
</script>

<style>
  .ml-build { scroll-margin-block-start: 1rem; }
  .ml-build-stage { padding-block: 3rem; }
  .ml-build-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 0.8fr); align-items: center; gap: clamp(1.5rem, 4vw, 4.5rem); }
  .ml-build-story h2 { margin-block: 1rem; font-size: clamp(2.4rem, 4.1vw, 4.2rem); line-height: 1.1; }
  .ml-build-intro { font-size: 0.9375rem; }
  .ml-build-stages { display: grid; margin-block-start: 1.5rem; list-style: none; }
  .ml-build-stage-button { display: flex; gap: 0.85rem; align-items: center; min-height: 44px; width: 100%; padding-block: 0.65rem; border-block-end: 1px solid var(--ml-border); text-align: start; font-size: 0.875rem; color: var(--ml-muted); }
  .ml-build-stage-button:enabled { cursor: pointer; }
  .ml-build-stage-button[aria-pressed='true'] { color: var(--color-red-on-dark); }
  .ml-build-image { position: relative; aspect-ratio: 9 / 16; max-height: 66svh; width: 100%; max-width: 380px; justify-self: center; overflow: hidden; background: var(--color-night-800); }
  .ml-build-image img, .ml-build-image canvas { width: 100%; height: 100%; display: block; object-fit: contain; }
  .ml-build-image canvas { position: absolute; inset: 0; visibility: hidden; }
  [data-ready='true'] .ml-build-image canvas { visibility: visible; }
  [data-ready='true'] .ml-build-image img { visibility: hidden; }
  .ml-build-image-label { position: absolute; inset-inline: 0; inset-block-end: 0; padding: 0.65rem; background: rgb(14 15 17 / 0.88); font-size: 0.6rem; text-align: center; }
  .ml-build-datum { display: none; position: absolute; inset-inline: 0; bottom: 78%; border-block-start: 1px solid var(--color-red-on-dark); pointer-events: none; }
  [data-ready='true'] .ml-build-datum { display: block; }
  .ml-build-datum span { position: absolute; inset-inline-end: 0; bottom: 0.25rem; font: 500 0.5625rem var(--font-mono); color: var(--color-red-on-dark); background: var(--color-night-950); padding: 0.2rem; }
  .ml-build-number { font: 600 clamp(6rem, 12vw, 11rem)/1 var(--font-display); font-variant-numeric: tabular-nums; color: var(--color-concrete-050); margin-block: 0.6rem 1rem; }
  .ml-build-meter h3 { font-size: 1.15rem; font-weight: 500; margin-block-end: 0.5rem; }
  .ml-build-meter .ml-description { font-size: 0.875rem; }
  .ml-build-track { height: 2px; margin-block: 1.5rem; background: var(--ml-border); }
  .ml-build-track i { display: block; height: 100%; width: 100%; background: var(--color-red-on-dark); }
  .ml-build-toolbar { padding-block-start: 1.25rem; margin-block-start: 1.5rem; border-block-start: 1px solid var(--ml-border); }
  .ml-build-range { flex: 1; min-width: 180px; margin-inline: 0.5rem; }
  .ml-build-status { flex-basis: 100%; min-height: 1.15em; }
  [data-enhanced][data-mode='scroll'] .ml-build-runway { height: 240svh; }
  [data-enhanced][data-mode='scroll'] .ml-build-stage { position: sticky; top: 0; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; }
  @media (min-width: 800px) and (max-height: 780px) {
    .ml-build-stage { padding-block: 1.25rem; }
    .ml-build-image { max-height: 60svh; width: auto; }
    .ml-build-story h2 { font-size: 2.5rem; }
    .ml-build-intro { font-size: 0.8125rem; }
    .ml-build-stages { margin-block-start: 0.8rem; }
  }
  @media (max-width: 799px) {
    .ml-build-stage { padding-block: 1.5rem; }
    .ml-build-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1rem; }
    .ml-build-story { grid-column: 1 / -1; }
    .ml-build-story h2 { margin-block: 0.65rem; font-size: 2.3rem; }
    .ml-build-story h2 br { display: none; }
    .ml-build-intro { font-size: 0.8125rem; max-width: none; }
    .ml-build-stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem; margin-block-start: 0.6rem; }
    .ml-build-stage-button { display: grid; gap: 0.15rem; font-size: 0.65rem; min-height: 50px; }
    .ml-build-stage-button .t-tech { font-size: 0.65rem; }
    .ml-build-image { max-height: 36svh; width: auto; max-width: 100%; }
    .ml-build-meter .t-tech { font-size: 0.625rem; }
    .ml-build-number { font-size: 5.5rem; margin-block: 0.25rem; }
    .ml-build-meter h3 { font-size: 0.9rem; margin-block-start: 0.5rem; }
    .ml-build-meter .ml-description { font-size: 0.75rem; }
    .ml-build-meter .ml-source { display: none; }
    .ml-build-track { margin-block: 0.8rem; }
    .ml-build-toolbar { margin-block-start: 1rem; padding-block-start: 0.85rem; gap: 0.45rem; }
    .ml-build-range { flex-basis: 100%; order: -1; margin-inline: 0; }
    .ml-build-toolbar .ml-button { font-size: 0.7rem; min-height: 40px; padding: 0.5rem; }
    .ml-build-toolbar .ml-buttons { gap: 0.4rem; }
    .ml-build-status { font-size: 0.7rem; }
  }
</style>
